import streamlit as st
import pandas as pd

# ── Configuração da página ──────────────────────────────────────────────────
st.set_page_config(
    page_title="Gestão de Alunos",
    page_icon="🎓",
    layout="wide",
)

# ── Estado da sessão (banco de dados em memória) ────────────────────────────
if "alunos" not in st.session_state:
    st.session_state.alunos = []

if "editando" not in st.session_state:
    st.session_state.editando = None  # id do aluno em edição

# ── Helpers ─────────────────────────────────────────────────────────────────
def get_df():
    return pd.DataFrame(st.session_state.alunos) if st.session_state.alunos else pd.DataFrame(
        columns=["id", "nome", "matricula", "email", "telefone", "curso", "status"]
    )

def matricula_duplicada(matricula, ignorar_id=None):
    return any(
        a["matricula"] == matricula and a["id"] != ignorar_id
        for a in st.session_state.alunos
    )

def salvar_aluno(nome, matricula, email, telefone, curso, status, editando_id=None):
    if editando_id is not None:
        for a in st.session_state.alunos:
            if a["id"] == editando_id:
                a.update(nome=nome, matricula=matricula, email=email,
                         telefone=telefone, curso=curso, status=status)
        st.session_state.editando = None
    else:
        novo_id = max((a["id"] for a in st.session_state.alunos), default=0) + 1
        st.session_state.alunos.append(dict(
            id=novo_id, nome=nome, matricula=matricula, email=email,
            telefone=telefone, curso=curso, status=status
        ))

def excluir_aluno(aluno_id):
    st.session_state.alunos = [a for a in st.session_state.alunos if a["id"] != aluno_id]

# ── Cabeçalho ───────────────────────────────────────────────────────────────
st.title("🎓 Gestão de Alunos")
st.divider()

# ── Cards de estatísticas ───────────────────────────────────────────────────
df = get_df()
col1, col2, col3 = st.columns(3)
col1.metric("Total de Alunos", len(df))
col2.metric("Ativos", int((df["status"] == "Ativo").sum()) if not df.empty else 0)
col3.metric("Inativos / Trancados", int((df["status"] != "Ativo").sum()) if not df.empty else 0)

st.divider()

# ── Formulário ──────────────────────────────────────────────────────────────
editando_id = st.session_state.editando
aluno_edit = next((a for a in st.session_state.alunos if a["id"] == editando_id), {})

titulo_form = f"✏️ Editando: {aluno_edit.get('nome', '')}" if editando_id else "➕ Novo Aluno"
with st.expander(titulo_form, expanded=True):
    with st.form("form_aluno", clear_on_submit=True):
        c1, c2 = st.columns(2)
        nome       = c1.text_input("Nome Completo *", value=aluno_edit.get("nome", ""))
        matricula  = c2.text_input("Matrícula *",     value=aluno_edit.get("matricula", ""))
        email      = c1.text_input("E-mail *",        value=aluno_edit.get("email", ""))
        telefone   = c2.text_input("Telefone",        value=aluno_edit.get("telefone", ""))
        curso      = c1.text_input("Curso",           value=aluno_edit.get("curso", ""))
        status     = c2.selectbox(
            "Status",
            ["Ativo", "Inativo", "Trancado"],
            index=["Ativo", "Inativo", "Trancado"].index(aluno_edit.get("status", "Ativo"))
        )

        salvar_btn, cancelar_btn = st.columns([1, 5])
        submitted = salvar_btn.form_submit_button("✓ Salvar", use_container_width=True, type="primary")
        cancelar  = cancelar_btn.form_submit_button("Cancelar", use_container_width=False)

        if cancelar:
            st.session_state.editando = None
            st.rerun()

        if submitted:
            if not nome or not matricula or not email:
                st.error("⚠️ Preencha os campos obrigatórios: Nome, Matrícula e E-mail.")
            elif matricula_duplicada(matricula, ignorar_id=editando_id):
                st.error("⚠️ Essa matrícula já está cadastrada!")
            else:
                salvar_aluno(nome, matricula, email, telefone, curso, status, editando_id)
                msg = "Aluno atualizado!" if editando_id else "Aluno cadastrado!"
                st.success(f"✅ {msg}")
                st.rerun()

st.divider()

# ── Lista de alunos ──────────────────────────────────────────────────────────
st.subheader("📋 Lista de Alunos")

busca = st.text_input("🔍 Buscar por nome, matrícula ou curso", placeholder="Digite para filtrar...")

df = get_df()
if busca:
    mask = (
        df["nome"].str.contains(busca, case=False, na=False) |
        df["matricula"].str.contains(busca, case=False, na=False) |
        df["curso"].str.contains(busca, case=False, na=False)
    )
    df = df[mask]

if df.empty:
    st.info("Nenhum aluno encontrado. Cadastre o primeiro!")
else:
    STATUS_ICON = {"Ativo": "🟢", "Inativo": "🔴", "Trancado": "🟣"}

    header = st.columns([3, 2, 3, 2, 2])
    for col, label in zip(header, ["Nome / E-mail", "Matrícula", "Curso", "Status", "Ações"]):
        col.markdown(f"**{label}**")
    st.markdown("---")

    for _, row in df.iterrows():
        cols = st.columns([3, 2, 3, 2, 2])
        cols[0].markdown(f"**{row['nome']}**  \n<small>{row['email']}</small>", unsafe_allow_html=True)
        cols[1].write(row["matricula"])
        cols[2].write(row["curso"] or "—")
        icone = STATUS_ICON.get(row["status"], "")
        cols[3].write(f"{icone} {row['status']}")

        with cols[4]:
            b1, b2 = st.columns(2)
            if b1.button("✏️", key=f"edit_{row['id']}", help="Editar"):
                st.session_state.editando = int(row["id"])
                st.rerun()
            if b2.button("🗑️", key=f"del_{row['id']}", help="Excluir"):
                excluir_aluno(int(row["id"]))
           st.rerun()
